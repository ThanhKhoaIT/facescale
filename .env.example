# Copy to .env and fill in real values

# --- Headscale ---
# Local sandbox default (see docker-compose.yml). Point to prod instance when ready.
HEADSCALE_URL=http://localhost:8080
HEADSCALE_API_KEY=

# --- Google OAuth (NextAuth) ---
# TODO(khoa): create a real OAuth client in Google Cloud Console (Lixibox org),
# redirect URI: http://localhost:3000/api/auth/callback/google
# Until then, local dev uses fake values in .env (real Google login will fail).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Comma-separated list of allowed email domains, auto-approved on login
ALLOWED_EMAIL_DOMAINS=lixibox.com

# --- Database ---
DATABASE_URL="file:./dev.db"

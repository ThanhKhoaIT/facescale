# Copy to .env and fill in real values

# --- Headscale ---
# Local sandbox default (see docker-compose.yml). Point to prod instance when ready.
HEADSCALE_URL=http://localhost:8080
HEADSCALE_API_KEY=

# --- Auth (NextAuth) ---
# "password" (self-service email+password signup/login, default) or "slack_otp"
# (email -> OTP code sent via Slack DM). Login UI on `/` switches based on this.
AUTH_METHOD=password

# Only needed when AUTH_METHOD=slack_otp.
# TODO(khoa): create a real Slack app/bot (scopes: users:read.email, chat:write,
# im:write) and put its Bot User OAuth Token here. Fake value below lets the app
# boot but sendOtpToSlack() will fail until replaced.
SLACK_BOT_TOKEN=fake-slack-bot-token

# Port 3000 is often taken by other local projects (e.g. Rails apps) — this
# project defaults to 3001, see package.json `dev`/`start` scripts.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# Comma-separated list of allowed email domains, auto-approved on login
ALLOWED_EMAIL_DOMAINS=lixibox.com

# --- Database ---
DATABASE_URL="file:./dev.db"
